# Zerr* Windows/MinGW-w64 profile (moved here from puredata/mingw-profile.txt so
# that all profiles live in one place alongside the root conanfile.txt).
#
# Unlike profiles/macos and profiles/linux this is a full standalone profile: it
# describes a cross-compilation target, so it cannot `include(default)` -- every
# setting has to be stated explicitly rather than inherited from the host machine.

[settings]
os=Windows
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=13
compiler.libcxx=libstdc++11
compiler.threads=posix
compiler.exception=seh
compiler.cppstd=17

[conf]
tools.build:compiler_executables={"c":"x86_64-w64-mingw32-gcc","cpp":"x86_64-w64-mingw32-g++"}